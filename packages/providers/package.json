{
  "version": "0.1.0",
  "license": "MIT",
  "author": "Andrew Cates <catesandrew@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/swarmdriver.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "name": "@caps/providers",
  "description": "Cloud-grid provider implementations for swarmdriver. Importing this package registers its providers with @caps/core.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./saucelabs": {
      "types": "./dist/types/saucelabs/index.d.ts",
      "import": "./dist/saucelabs.js",
      "require": "./dist/saucelabs.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caps/core": "workspace:*",
    "@caps/cli": "workspace:*",
    "@caps/reporters": "workspace:*",
    "@wdio/sauce-service": "^9.0.0",
    "lodash": "^4.17.21",
    "wdio-reportportal-reporter": "^7.6.0",
    "wdio-reportportal-service": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
