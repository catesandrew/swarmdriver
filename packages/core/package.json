{
  "version": "0.1.0",
  "license": "MIT",
  "author": "Andrew Cates <catesandrew@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/swarmdriver.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "name": "@caps/core",
  "description": "Env-var driven WebdriverIO + Appium config builder: core config matrix, helpers, machines and the cloud-provider registry.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./faker": {
      "types": "./dist/types/exports/faker.d.ts",
      "import": "./dist/faker.js",
      "require": "./dist/faker.cjs"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./enums": {
      "types": "./dist/types/enums/index.d.ts",
      "import": "./dist/enums.js",
      "require": "./dist/enums.cjs"
    },
    "./helpers": {
      "types": "./dist/types/helpers/index.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    },
    "./machines": {
      "types": "./dist/types/machines/index.d.ts",
      "import": "./dist/machines.js",
      "require": "./dist/machines.cjs"
    },
    "./providers": {
      "types": "./dist/types/providers/index.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/providers.cjs"
    },
    "./services": {
      "types": "./dist/types/services/index.d.ts",
      "import": "./dist/services.js",
      "require": "./dist/services.cjs"
    },
    "./services/base": {
      "types": "./dist/types/services/base.d.ts",
      "import": "./dist/services/base.js",
      "require": "./dist/services/base.cjs"
    },
    "./services/utils": {
      "types": "./dist/types/services/utils.d.ts",
      "import": "./dist/services/utils.js",
      "require": "./dist/services/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caps/reporters": "workspace:*",
    "@axe-core/webdriverio": "^4.10.2",
    "@faker-js/faker": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/config": "^9.0.0",
    "@wdio/jasmine-framework": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/logger": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/repl": "^9.0.0",
    "@wdio/runner": "^9.0.0",
    "@wdio/shared-store-service": "^9.0.0",
    "@wdio/static-server-service": "^9.0.0",
    "@wdio/utils": "^9.0.0",
    "@wdio/webdriver-mock-service": "^9.0.0",
    "appium": "^2.11.0",
    "aria-query": "^5.3.2",
    "chalk": "^4.1.2",
    "lodash": "^4.17.21",
    "loglevel-plugin-prefix": "^0.8.4",
    "mocha-steps": "^1.3.0",
    "wdio-intercept-service": "^4.4.1",
    "webdriver": "^9.0.0",
    "webdriverio": "^9.0.0",
    "yn": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
