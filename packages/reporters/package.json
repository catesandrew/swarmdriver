{
  "version": "0.1.0",
  "license": "MIT",
  "author": "Andrew Cates <catesandrew@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/swarmdriver.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "name": "@caps/reporters",
  "description": "WebdriverIO reporters and reporter config builders (spec, junit, ReportPortal, Sauce Labs job comments).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/dot-reporter": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/reporter": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "pretty-ms": "^7.0.1",
    "strip-ansi": "^6.0.1",
    "wdio-reportportal-reporter": "^7.6.0",
    "wdio-reportportal-service": "^7.3.1",
    "yn": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
