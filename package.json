{
  "name": "swarmdriver",
  "private": true,
  "description": "Env-var driven WebdriverIO + Appium config builder. One config matrix for local/cloud x browser/app x desktop/device. Monorepo root — the publishable packages live in packages/*.",
  "license": "MIT",
  "author": "Andrew Cates <catesandrew@gmail.com>",
  "homepage": "https://github.com/catesandrew/swarmdriver#readme",
  "bugs": {
    "url": "https://github.com/catesandrew/swarmdriver/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/swarmdriver.git"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "appium",
    "saucelabs",
    "e2e",
    "testing",
    "automation",
    "mobile",
    "browser"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:watch": "vitest",
    "smoke": "pnpm --filter @caps/integration-tests smoke",
    "build-docs": "typedoc",
    "docs:dev": "pnpm --filter site start",
    "docs:build": "pnpm --filter site build",
    "docs:serve": "pnpm --filter site serve",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.0.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0"
  }
}
