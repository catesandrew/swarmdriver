{
  "name": "swarmdriver",
  "version": "0.1.0",
  "description": "Env-var driven WebdriverIO + Appium config builder. One config matrix for local/cloud x browser/app x desktop/device.",
  "license": "MIT",
  "author": "Andrew Cates <catesandrew@gmail.com>",
  "homepage": "https://github.com/catesandrew/swarmdriver#readme",
  "bugs": {
    "url": "https://github.com/catesandrew/swarmdriver/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/swarmdriver.git"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "appium",
    "saucelabs",
    "e2e",
    "testing",
    "automation",
    "mobile",
    "browser"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./faker": {
      "types": "./dist/types/exports/faker.d.ts",
      "import": "./dist/faker.js",
      "require": "./dist/faker.cjs"
    },
    "./sauce-cli": {
      "types": "./dist/types/sauce-cli/index.d.ts",
      "import": "./dist/sauce-cli.js",
      "require": "./dist/sauce-cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "bin": {
    "swarm-allure": "./bin/allure.js",
    "swarm-appium": "./bin/appium.js",
    "swarm-jasmine": "./bin/jasmine.js",
    "swarm-sauce": "./bin/sauce.js",
    "swarm-sauce-connect": "./bin/sauce-connect",
    "swarm-sauce-storage": "./bin/sauce-storage.js",
    "swarm-wdio": "./bin/wdio.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "build-docs": "typedoc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-wdio-config.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@axe-core/webdriverio": "^4.10.2",
    "@faker-js/faker": "^9.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/config": "^9.0.0",
    "@wdio/dot-reporter": "^9.0.0",
    "@wdio/jasmine-framework": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/logger": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/repl": "^9.0.0",
    "@wdio/reporter": "^9.0.0",
    "@wdio/runner": "^9.0.0",
    "@wdio/sauce-service": "^9.0.0",
    "@wdio/shared-store-service": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/static-server-service": "^9.0.0",
    "@wdio/utils": "^9.0.0",
    "@wdio/webdriver-mock-service": "^9.0.0",
    "allure-commandline": "^2.29.0",
    "appium": "^2.11.0",
    "aria-query": "^5.3.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "form-data": "^4.0.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "loglevel-plugin-prefix": "^0.8.4",
    "mocha-steps": "^1.3.0",
    "node-fetch": "^2.7.0",
    "pretty-ms": "^7.0.1",
    "strip-ansi": "^6.0.1",
    "wdio-intercept-service": "^4.4.1",
    "wdio-reportportal-reporter": "^7.6.0",
    "wdio-reportportal-service": "^7.3.1",
    "webdriver": "^9.0.0",
    "webdriverio": "^9.0.0",
    "yn": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.0.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
